# Xiaomi Pad 5 Pro (elish, SM8250 / Kona) Android-only runtime.
# Keys/SPMI are the standard Kona layout already proven by hdk8250 evidence;
# display is discovered from the live SDE state and the DT splash reservation
# (cont_splash_region@0x9c000000, matching the verified Kona splash address).
# Menu starts on volume/power keys; touch and SMP are enabled later, after the
# elish touch controller is wired into the kernel.
CONFIG_QCOM_KEYS=y
CONFIG_QCOM_SPMI=y
CONFIG_QCOM_KEY_DEBOUNCE_SAMPLES=2
# CONFIG_KSHIM_QEMU_PLATFORM is not set
CONFIG_KSHIM_FRAMEBUFFER=y
CONFIG_KSHIM_SPLASH_LIVE_FALLBACK=y
CONFIG_KSHIM_LVGL=y
# Panel is 1600x2560 native (dual-CPHY K81), mounted rotated 90 degrees in the
# landscape chassis: the live scanout is a portrait 1600x2560 frame, so the boot
# menu renders a landscape 2560x1600 UI and rotates it into the native scanout.
CONFIG_KSHIM_UI_ROTATION_CCW=270
CONFIG_KSHIM_MENU_ENTRY_DURATION_MS=0
# 23 logical 2560-pixel rows, within the existing 4 MiB runtime slot.
CONFIG_KSHIM_LVGL_BUFFER_BYTES=243712
# CONFIG_KSHIM_TOUCH is not set
# CONFIG_KSHIM_SMP is not set
# CONFIG_KSHIM_UEFI_TEST_MENU is not set
# CONFIG_ENABLE_BANNER is not set
CONFIG_DEBUG_LEVEL_NONE=y
# CONFIG_KSHIM_DEBUG_CONSOLE is not set
CONFIG_ASSERT_HALT=y
CONFIG_KSHIM_MENU_STYLE_STAR_CHART=y
CONFIG_KSHIM_MENU_LANGUAGE_SWITCH=y
CONFIG_KSHIM_MENU_SESSION_SETTINGS=y

CONFIG_KSHIM_MENU_CHINESE=y
CONFIG_KSHIM_MENU_ENTRY_DETAILS=y
CONFIG_KSHIM_MENU_BASE_ANDROID=y
CONFIG_KSHIM_MENU_POWER_ACTIONS=y
CONFIG_KSHIM_MENU_ADVANCED_ACTIONS=y
CONFIG_KSHIM_QCOM_REBOOT=y
# CONFIG_KSHIM_BOOT_TIMING is not set
